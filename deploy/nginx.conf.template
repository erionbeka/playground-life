# Rendered by the nginx image's envsubst template step. API_UPSTREAM is the
# address of the API process:
#   compose        -> api:4000        (the api service on the compose network)
#   single host    -> 127.0.0.1:4000 (the API running on the same machine)
server {
  listen 80;
  server_name _;
  root /var/www/html;
  index index.html;

  # Compress text responses. Without this the landing page ships ~470 KB of raw
  # JS instead of ~130 KB. `gzip_vary` matters behind Cloudflare so the edge
  # caches the compressed copy correctly.
  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    text/plain
    text/css
    text/xml
    application/javascript
    application/json
    application/xml
    application/rss+xml
    image/svg+xml
    font/woff
    font/woff2;

  # Enable brotli only if the module is installed (nginx -V | grep brotli).
  # brotli on;
  # brotli_comp_level 6;
  # brotli_types text/plain text/css application/javascript application/json image/svg+xml;

  # Hashed build assets never change, so cache them hard at every layer.
  # imgs/ is a separate bucket and assets/ may contain non-hashed files, so
  # match only files that carry an 8+ char hash segment.
  location ~* ^/(assets|imgs)/.+-[A-Za-z0-9_-]{8,}\.(?:js|css|woff2?|png|svg|jpe?g|webp)$ {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    access_log off;
    try_files $uri =404;
  }

  # The HTML shell must never be cached, otherwise a deploy keeps handing
  # visitors a document that points at asset hashes the edge no longer has.
  location = /index.html {
    add_header Cache-Control "no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache, must-revalidate" always;
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /sw.js {
    add_header Cache-Control "no-cache, must-revalidate" always;
    try_files $uri =404;
  }

  location /health {
    return 200 'ok';
    add_header Content-Type text/plain;
  }
}
