FROM node:22-alpine AS base
WORKDIR /app
ENV NODE_ENV=production

FROM base AS deps
COPY package*.json ./
# The API image only needs the runtime dependencies. The build toolchain
# (vite, vitest, tailwind, eslint and their trees) stays out of the deployed
# container, so a vulnerable build-time package cannot ship to production.
RUN npm ci --omit=dev


FROM base AS build
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && npm run typecheck:server

FROM base AS api
COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./
COPY server ./server
COPY tsconfig*.json ./
EXPOSE 4000
CMD ["node", "--import", "tsx", "server/index.ts"]
