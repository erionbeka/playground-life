PORT=4000
NODE_ENV=development
# The Postgres container publishes on POSTGRES_PORT. DATABASE_URL must use the
# same port, otherwise the API cannot reach the database.
POSTGRES_PORT=5432
DATABASE_URL=postgres://playground:playground@127.0.0.1:5432/playground_life
# Separate throwaway database used only by the restore drill. Its name must
# contain test, restore, drill, or staging. Leave unset to skip drills.
RESTORE_TEST_DATABASE_URL=postgres://playground:playground@localhost:5432/playground_life_restore
# Where backup scripts write dumps (default: /var/backups/playground-life).
BACKUP_DIR=/var/backups/playground-life
# Optional shell command invoked with the dump path to push backups offsite.
# Example: OFFSITE_CMD="aws s3 cp" or OFFSITE_CMD="rsync -az -e ssh"
OFFSITE_CMD=
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Transactional email (outbox). If SMTP vars are set, `npm run mail:worker` will
# deliver queued emails. For Gmail use an App Password (not your account password).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Playground Life <no-reply@playground-life.com>"
APP_URL=http://localhost:8080
VITE_API_URL=
